+    CUDNN_WHEEL_LIB=$(python -c "import nvidia.cudnn, os; path=os.path.join(nvidia.cudnn.__path__[0], 'lib', 'libcudnn.so.9'); print(path if os.path.exists(path) else '')" 2>/dev/null || echo "")
+    if [ -n "$CUDNN_WHEEL_LIB" ]; then CUDNN_LINK_LIB="$CUDNN_WHEEL_LIB"; fi
