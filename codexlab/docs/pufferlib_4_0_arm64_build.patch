 }
 
+build_raylib_from_source() {
+    local name=$1
+    [ -f "$name/lib/libraylib.a" ] && return
+    local source_dir="raylib-5.5"
+    download "$source_dir" "https://github.com/raysan5/raylib/archive/refs/tags/5.5.tar.gz"
+    make -C "$source_dir/src" PLATFORM=PLATFORM_DESKTOP RAYLIB_LIBTYPE=STATIC -j"$(nproc)"
+    mkdir -p "$name/include" "$name/lib"
+    cp "$source_dir/src/libraylib.a" "$name/lib/libraylib.a"
+    cp "$source_dir/src/raylib.h" "$source_dir/src/raymath.h" "$source_dir/src/rlgl.h" "$name/include/"
+}
+
 RAYLIB_URL="https://github.com/raysan5/raylib/releases/download/5.5"
